# Optional public site URL used for canonical links and sitemap generation
VITE_SITE_URL=https://example.com

# Optional override for the external USD -> BRL conversion rate
VITE_EXTERNAL_USD_TO_BRL=5.5

# Optional repository URL surfaced in the UI
VITE_REPOSITORY_URL=https://github.com/owner/repo

# YouTube Data API v3 key used to fetch gameplay videos for each game.
# Create one at https://console.cloud.google.com/ (enable "YouTube Data API v3").
# IMPORTANT: restrict the key by HTTP referrer (your domain) because it is
# exposed in the client bundle of this static SPA.
VITE_YOUTUBE_API_KEY=
