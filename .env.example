# Web build. Keep VITE_API_BASE_URL empty when the API is served from the same origin.
VITE_SITE_URL=http://localhost:5173
VITE_API_BASE_URL=http://localhost:3001
VITE_EXTERNAL_USD_TO_BRL=
VITE_REPOSITORY_URL=

# API runtime.
NODE_ENV=development
HOST=0.0.0.0
PORT=3001
WEB_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
PUBLIC_WEB_URL=http://localhost:5173
API_PUBLIC_URL=http://localhost:3001
DATABASE_URL=postgresql://amigos:amigos_local_only@localhost:5432/amigos
SESSION_SECRET=replace-with-at-least-32-random-characters
TOKEN_PEPPER=replace-with-another-32-character-secret
ROOM_TTL_HOURS=168
GUEST_SESSION_TTL_HOURS=168
ADMIN_SESSION_TTL_HOURS=12
MAX_ROOM_PARTICIPANTS=12
BODY_LIMIT_BYTES=65536
LOG_LEVEL=info

# Server-only YouTube Data API v3 key. Never expose this value through VITE_*.
YOUTUBE_API_KEY=
YOUTUBE_CACHE_TTL_HOURS=720
YOUTUBE_NEGATIVE_CACHE_TTL_HOURS=72
